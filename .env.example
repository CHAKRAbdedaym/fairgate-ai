# Run all commands from repository root. No paid services required.
APP_MODE=demo
DATABASE_URL=sqlite:///./backend/fairgate.db
BACKEND_PORT=8000
FRONTEND_PORT=3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Optional, server-side Salesforce OAuth client credentials.
# Never import CRM data into the synthetic demo database.
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=v66.0
SALESFORCE_WRITE_ENABLED=false
